{
  "name": "fst-settat-blockout",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "description": "FST Settat - walkable 3D campus game (Three.js), driven by WorldLayout.json",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "validate": "node scripts/validate-layout.mjs",
    "test:arch": "node scripts/arch-test.mjs",
    "test:reach": "node scripts/reach-test.mjs",
    "assumptions": "node scripts/export-assumptions.mjs",
    "qa:install": "npm i -D puppeteer-core @sparticuz/chromium",
    "qa:behaviour": "sh qa/run.sh qa/behaviour.mjs",
    "vids": "node scripts/gen-vids.mjs",
    "predev": "node scripts/gen-vids.mjs",
    "prebuild": "node scripts/gen-vids.mjs"
  },
  "dependencies": {
    "polygon-clipping": "^0.15.7",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "puppeteer-core": "^25.17.0",
    "vite": "^5.4.11"
  }
}